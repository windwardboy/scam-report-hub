<?php
// Configuration File - Store Outside Web Root (e.g., /home/sites/your_acc/config.php)
//
// IMPORTANT: Copy this file to 'config.php' and fill in your actual values.
// The config.php file is excluded from version control for security.
//
// On the production server, this file should be located outside the web root
// and referenced using an absolute path in your PHP files.
// Example: require_once '/home/sites/32b/b/b19bae1aa8/config.php';

// --- Database Credentials ---
// Replace the placeholder values below with your actual database details
define('DB_HOST', 'your-database-host');       // Usually 'localhost' on 20i, but check your DB details
define('DB_NAME', 'your-database-name');       // Your specific database name
define('DB_USER', 'your-database-username');   // Your database username
define('DB_PASS', 'your-database-password');   // Your database password
define('DB_CHARSET', 'utf8mb4');                // Database character set (usually utf8mb4)

// --- Google reCAPTCHA v2 Secret Key ---
// Replace the placeholder value below with your actual secret key
// Get your keys from: https://www.google.com/recaptcha/admin
define('RECAPTCHA_SECRET_KEY', 'your-recaptcha-secret-key');

// --- Other Settings (Optional examples) ---
// define('SITE_URL', 'https://www.scamreporthub.com');
// define('ADMIN_EMAIL', 'admin@example.com');


// --- Security Check ---
// Prevent this file from being accessed directly if accidentally placed in the web root.
if (basename(__FILE__) == basename($_SERVER["SCRIPT_FILENAME"])) {
    // Using die() is simple; could also redirect or show a generic error
    http_response_code(403); // Forbidden
    die('Access Denied');
}

?>
